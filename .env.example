# Local auth (MVP — replace with Supabase when connected)
AUTH_SECRET=fweta-local-dev-secret-change-me
PAYOUT_ENCRYPTION_KEY=fweta-payout-key-change-me

# Supabase (Phase 1+ when migrating off file store)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # Required on Vercel — Settings → API → service_role secret

# Background jobs (Trigger.dev — pick one provider)
TRIGGER_SECRET_KEY=
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# Vercel Cron — openssl rand -base64 32
CRON_SECRET=

# Social view polling (Apify — optional; falls back to simulation without token)
# Get token: https://console.apify.com/settings/integrations
APIFY_API_TOKEN=
# APIFY_ACTOR_ID=agentx~all-video-scraper

# App
NEXT_PUBLIC_APP_URL=https://app.fweta.com

# Future: brand deposit gateways
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# PAYFAST_*=

# Future: social API keys for view polling
# TIKTOK_CLIENT_KEY=
# YOUTUBE_API_KEY=
# INSTAGRAM_GRAPH_TOKEN=
