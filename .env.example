# Copy to .env.local for local dev. Leave secrets blank locally — the app uses a
# dev-only fallback outside production. Production must set unique values.
# Generate with: openssl rand -base64 32
AUTH_SECRET=
PAYOUT_ENCRYPTION_KEY=

# Admin seed. Hashed at seed time. Set both, or no admin account is created.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Supabase. When both URL and a secret key are set, the app uses Postgres.
# When they are unset, local dev uses data/store.json.
# FWETA_STORE=file forces the file even if keys are present.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=
# FWETA_STORE=file
# FWETA_RELATIONAL_SYNC=true
# FWETA_SEED_DEMO=true

# Vercel Cron — required in production for /api/jobs/housekeeping
# (campaign end, unused-budget settlement, booking hold release). Does not fetch views.
CRON_SECRET=

# Optional error sink (Slack incoming webhook or any JSON collector). Server only.
# ERROR_WEBHOOK_URL=

# View counts are entered by an admin at /dashboard/admin/views.
# Do not set Apify or TikTok / Meta / Instagram / YouTube / X API keys for go-live.
# Later: apply for TikTok and Meta developer apps, then enable the official providers.

# App
NEXT_PUBLIC_APP_URL=https://app.fweta.com

# Transactional email (Resend). If either is unset, sends are skipped.
# RESEND_FROM must be an address on a domain verified in Resend.
RESEND_API_KEY=
RESEND_FROM=fweta <notifications@fweta.com>

# Brand deposits and creator payouts are manual. There is no payment gateway.
# Leave STRIPE_* and PAYFAST_* unset.
